.venv/
__pycache__/
*.pyc
.ansible/
*.retry
.pytest_cache/
.coverage
*.egg-info/

# Local-only, machine-specific Python interpreter override — points at
# this machine's .venv via an absolute path (Homebrew's Ansible runs
# under python3.10, too old for openshell>=0.0.70's Python floor — see
# .venv/ above). ansible.cfg itself is now committed (roles_path and
# callback settings are portable) — only this file, which sets
# ansible_python_interpreter for the implicit localhost host, stays
# per-developer.
host_vars/localhost.yml

# ansible-builder's generated build context — regenerated on every
# `ansible-builder build`, never hand-edited.
context/

# Local collection tarballs (built via `ansible-galaxy collection
# build`, see build/requirements.yml) — regeneratable build artifacts,
# not source. Keep build/requirements.yml itself tracked though.
build/collections/*.tar.gz

# Vendored copy of ansible-openshell's scripts/ssh_proxy.py, baked into
# the EE so ssh_proxy_script doesn't need to point at a personal git
# checkout path (see execution-environment.yml). Not this repo's
# source — regenerate from a checkout of
# https://github.com/aknochow/ansible-openshell with:
#   cp /path/to/ansible-openshell/scripts/ssh_proxy.py build/scripts/ssh_proxy.py
build/scripts/*.py

# Same reasoning as build/scripts/*.py above, same local-only treatment
# -- CA cert(s) needed ONLY if your own environment clones git targets
# from a host signed by an internal/private CA (see
# execution-environment.yml's commented-out CA-trust block for how to
# wire these back in). Never this repo's own source -- an org-specific
# trust anchor has no business being a default for anyone else building
# this EE.
build/certs/*.crt

# Scratch debug output (ad hoc test-run logs, etc.) — never source,
# kept repo-local instead of /tmp so reads stay inside the trusted
# working-directory tree.
tmp/

# Side effects of unrelated local tooling, not ansible-plaibook source.
# .nicegui/: left behind by `ai-guardian setup` (a Red Hat Product
# Security tool, unrelated to this repo) writing its NiceGUI local
# storage relative to whatever CWD it was launched from.
# artifacts/: auto-generated by the rh-pre-commit hook as a side effect
# of commits in this repo -- a copy of a review report, not authored.
.nicegui/
artifacts/
public/
.claude/worktrees/
